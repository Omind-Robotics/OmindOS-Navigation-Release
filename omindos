#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
command="${1:-help}"
case "$command" in
 help|-h|--help)
  printf '%s\n' 'OmindOS Navigation 0.2.0-preview.2 · Linux amd64' \
   './omindos verify' './omindos install' './omindos test' \
   './omindos preview quadruped|wheeled_diff|wheeled_omni' \
   './omindos api --store /absolute/path/robot-configurations [--port 8085]' \
   './omindos api-test' './omindos profiles'
  exit 0;;
 verify|install|test|preview|profiles|api|api-test) ;;
 *) echo 'Unknown command; run ./omindos help' >&2; exit 2;;
esac
(cd "$root" && sha256sum --strict --check --quiet SHA256SUMS)
shift
case "$command" in
 verify) "$root/runtime/omindos" verify;;
 api)
  # Resolve customer paths in the caller's working directory. Never delete the store.
  exec python3 "$root/scripts/robot_parameter_api.py" "$@";;
 api-test) PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s "$root/tests" -v;;
 test)
  PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s "$root/tests" -v
  exec "$root/runtime/omindos" test "$@";;
 *) exec "$root/runtime/omindos" "$command" "$@";;
esac
